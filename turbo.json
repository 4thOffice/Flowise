{
    "$schema": "https://turborepo.dev/schema.json",
    "envMode": "loose",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**"]
        },
        "test": {},
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
